@using System

@{
    string NombreUsuario =
        Convert.ToString(Session["NombreUsuario"]);

    string NombreRol =
        Convert.ToString(Session["NombreRol"]);

    int IdUsuarioSesion = Session["IdUsuario"] != null
        ? Convert.ToInt32(Session["IdUsuario"])
        : 0;

    if (string.IsNullOrWhiteSpace(NombreUsuario))
    {
        NombreUsuario = "Usuario";
    }

    if (string.IsNullOrWhiteSpace(NombreRol))
    {
        NombreRol = "Sesión activa";
    }

    string Iniciales = "US";

    string[] PartesNombre = NombreUsuario.Split(
        new[] { ' ' },
        StringSplitOptions.RemoveEmptyEntries
    );

    if (PartesNombre.Length >= 2)
    {
        Iniciales =
            PartesNombre[0].Substring(0, 1) +
            PartesNombre[1].Substring(0, 1);
    }
    else if (PartesNombre.Length == 1)
    {
        Iniciales =
            PartesNombre[0].Substring(0, 1);
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Panel administrativo LEN">

    <title>@ViewBag.Title | LEN</title>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/bootstrap.min.css")">

    <link rel="stylesheet"
          href="@Url.Content("~/Content/bootstrap-icons/bootstrap-icons.css")">

    <link rel="stylesheet"
          href="@Url.Content("~/Content/GeneralStyle.css?v=1")">

    @RenderSection("Estilos", required: false)
</head>

<body>
    <div class="admin-shell">

        <div class="sidebar-backdrop"
             data-sidebar-close>
        </div>

        <aside class="admin-sidebar"
               id="adminSidebar"
               aria-label="Navegación principal">

            <div class="sidebar-header">

                <a class="brand-mark"
                   href="@Url.Action("Principal", "Home")"
                   aria-label="Panel principal LEN">

                    <span class="brand-icon">
                        <i class="bi bi-grid-1x2-fill"
                           aria-hidden="true"></i>
                    </span>

                    <span class="brand-copy">

                        <span class="brand-title">
                            LEN
                        </span>

                        <span class="brand-subtitle">
                            Panel Administrativo
                        </span>

                    </span>

                </a>

            </div>

            <nav class="sidebar-nav">

                <a class="nav-link"
                   href="@Url.Action("Principal", "Home")">

                    <span class="nav-icon">
                        <i class="bi bi-speedometer2"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Principal
                    </span>

                </a>

                @if (string.Equals(
                    NombreRol,
                    "Administrador",
                    StringComparison.OrdinalIgnoreCase))
                     {
                    <a class="nav-link"
                       href="@Url.Action(
                    "Administracion",
                    "Usuario"
                     )">

                        <span class="nav-icon">
                            <i class="bi bi-people"
                               aria-hidden="true"></i>
                        </span>

                        <span class="nav-text">
                            Usuarios
                        </span>
                    </a>
                }

                <a class="nav-link"
                   href="@Url.Action("Index", "Producto")">

                    <span class="nav-icon">
                        <i class="bi bi-box-seam"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Productos
                    </span>

                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Categoria")">

                    <span class="nav-icon">
                        <i class="bi bi-tags"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Categorías
                    </span>

                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "PedidoAdmin")">

                    <span class="nav-icon">
                        <i class="bi bi-bag-check"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Pedidos
                    </span>

                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Reporte")">

                    <span class="nav-icon">
                        <i class="bi bi-graph-up"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Reportes
                    </span>

                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Pago")">

                    <span class="nav-icon">
                        <i class="bi bi-credit-card"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Pagos
                    </span>

                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "Factura")">

                    <span class="nav-icon">
                        <i class="bi bi-receipt"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Facturas
                    </span>

                </a>

            </nav>

            <a class="sidebar-user"
               href="@Url.Action(
                   "Detalle",
                   "Usuario",
                   new { IdUsuario = IdUsuarioSesion }
               )">

                <span class="profile-avatar avatar-md sidebar-user-avatar">
                    @Iniciales.ToUpper()
                </span>

                <strong>
                    @NombreUsuario
                </strong>

                <small>
                    @NombreRol
                </small>

            </a>

            <div class="sidebar-footer">

                <span class="status-dot"></span>

                <span class="sidebar-footer-text">
                    Sistema disponible
                </span>

            </div>

        </aside>

        <div class="admin-main">

            <nav class="navbar admin-navbar navbar-expand bg-white">

                <div class="container-fluid px-3 px-lg-4">

                    <button class="sidebar-toggle"
                            type="button"
                            data-sidebar-toggle
                            aria-controls="adminSidebar"
                            aria-expanded="true"
                            aria-label="Mostrar u ocultar menú">

                        <span></span>
                        <span></span>
                        <span></span>

                    </button>

                    <form class="d-none d-md-flex ms-3 flex-grow-1"
                          role="search">

                        <input class="form-control search-input"
                               type="search"
                               placeholder="Buscar productos, pedidos o usuarios"
                               aria-label="Buscar">

                    </form>

                    <div class="navbar-actions ms-auto">

                        <button class="icon-button theme-toggle"
                                type="button"
                                data-theme-toggle
                                aria-label="Cambiar tema"
                                title="Cambiar tema">

                            <i class="bi bi-moon-stars"
                               data-theme-icon
                               aria-hidden="true"></i>

                        </button>

                        <div class="dropdown">

                            <button class="icon-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Notificaciones">

                                <span class="notification-dot"></span>

                                <i class="bi bi-bell"
                                   aria-hidden="true"></i>

                            </button>

                            <div class="dropdown-menu dropdown-menu-end notification-menu">

                                <div class="dropdown-header fw-bold text-body">
                                    Notificaciones
                                </div>

                                <span class="dropdown-item-text text-muted">
                                    No hay notificaciones nuevas.
                                </span>

                            </div>

                        </div>

                        <div class="dropdown">

                            <button class="profile-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="profile-avatar avatar-sm">
                                    @Iniciales.ToUpper()
                                </span>

                                <span class="profile-name d-none d-sm-inline">
                                    @NombreUsuario
                                </span>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <a class="dropdown-item"
                                       href="@Url.Action(
                                           "Detalle",
                                           "Usuario",
                                           new { IdUsuario = IdUsuarioSesion }
                                       )">

                                        <i class="bi bi-person me-2"
                                           aria-hidden="true"></i>

                                        Perfil

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       href="@Url.Action(
                                           "Detalle",
                                           "Usuario",
                                           new { IdUsuario = IdUsuarioSesion }
                                       )#Seguridad">

                                        <i class="bi bi-shield-lock me-2"
                                           aria-hidden="true"></i>

                                        Seguridad

                                    </a>

                                </li>

                                <li>
                                    <hr class="dropdown-divider">
                                </li>

                                <li>

                                    @using (Html.BeginForm(
                                        "CerrarSesion",
                                        "Home",
                                        FormMethod.Post,
                                        new
                                        {
                                            id = "FormularioCerrarSesion",
                                            @class = "m-0"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item">

                                            <i class="bi bi-box-arrow-right me-2"
                                               aria-hidden="true"></i>

                                            Cerrar sesión

                                        </button>
                                    }

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </nav>

            <main class="dashboard-content">

                <div class="container-fluid px-3 px-lg-4 py-4">
                    @RenderBody()
                </div>

            </main>

            <footer class="admin-footer">

                <div class="container-fluid px-3 px-lg-4">

                    <span>
                        © @DateTime.Now.Year LEN Accessories.
                        Todos los derechos reservados.
                    </span>

                    <span>
                        Panel administrativo
                    </span>

                </div>

            </footer>

        </div>

    </div>

    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>

    <script src="@Url.Content("~/Scripts/main.js?v=1")"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>