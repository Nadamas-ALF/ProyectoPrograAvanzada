@model System.Collections.Generic.List<ProyectoProgramacionAvanzada.Models.CategoriaAdminViewModel>

@{
    ViewBag.Title = "Categorías";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Gestión de categorías</h1>
        <p class="text-muted m-0">
            Categorías que organizan el catálogo de la joyería.
        </p>
    </div>

    <button type="button"
            class="btn btn-dark"
            data-bs-toggle="modal"
            data-bs-target="#ModalCrearCategoria">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
        Nueva categoría
    </button>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensajeExito"]
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-warning" role="alert">
        @TempData["MensajeError"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="text-center py-5 border rounded">
        <h2 class="h5 pb-2">Aún no hay categorías registradas</h2>
        <p class="text-muted m-0">
            Cree la primera categoría para comenzar a organizar el catálogo.
        </p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" class="text-center">Productos</th>
                        <th scope="col" class="text-center">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Categoria in Model)
                    {
                        <tr>
                            <td><strong>@Categoria.NombreCategoria</strong></td>
                            <td class="text-muted">@Categoria.Descripcion</td>
                            <td class="text-center">@Categoria.CantidadProductos</td>
                            <td class="text-center">
                                <span class="badge @(Categoria.NombreEstado == "Activo" ? "bg-success" : "bg-secondary")">
                                    @Categoria.NombreEstado
                                </span>
                            </td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-dark"
                                        title="Editar categoría"
                                        data-bs-toggle="modal"
                                        data-bs-target="#ModalEditarCategoria"
                                        data-id="@Categoria.IdCategoria"
                                        data-nombre="@Categoria.NombreCategoria"
                                        data-descripcion="@Categoria.Descripcion">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>

                                @using (Html.BeginForm(
                                    "CambiarEstado",
                                    "Categoria",
                                    FormMethod.Post,
                                    new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Categoria.IdCategoria" />
                                    <button type="submit"
                                            class="btn btn-sm @(Categoria.NombreEstado == "Activo" ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(Categoria.NombreEstado == "Activo" ? "Desactivar" : "Activar")">
                                        <i class="bi @(Categoria.NombreEstado == "Activo" ? "bi-slash-circle" : "bi-arrow-counterclockwise")"
                                           aria-hidden="true"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal crear categoría -->
<div class="modal fade" id="ModalCrearCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Crear", "Categoria", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h2 class="modal-title h5">Nueva categoría</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="NombreCategoriaCrear">Nombre</label>
                        <input type="text"
                               class="form-control"
                               id="NombreCategoriaCrear"
                               name="NombreCategoria"
                               maxlength="100"
                               required />
                    </div>

                    <div class="mb-0">
                        <label class="form-label" for="DescripcionCrear">Descripción</label>
                        <textarea class="form-control"
                                  id="DescripcionCrear"
                                  name="Descripcion"
                                  maxlength="255"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-dark">
                        Guardar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal editar categoría -->
<div class="modal fade" id="ModalEditarCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Editar", "Categoria", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="IdCategoria" id="IdCategoriaEditar" />

                <div class="modal-header">
                    <h2 class="modal-title h5">Editar categoría</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="NombreCategoriaEditar">Nombre</label>
                        <input type="text"
                               class="form-control"
                               id="NombreCategoriaEditar"
                               name="NombreCategoria"
                               maxlength="100"
                               required />
                    </div>

                    <div class="mb-0">
                        <label class="form-label" for="DescripcionEditar">Descripción</label>
                        <textarea class="form-control"
                                  id="DescripcionEditar"
                                  name="Descripcion"
                                  maxlength="255"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-dark">
                        Guardar cambios
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var ModalEditar = document.getElementById("ModalEditarCategoria");

            if (!ModalEditar) {
                return;
            }

            ModalEditar.addEventListener("show.bs.modal", function (Evento) {
                var Boton = Evento.relatedTarget;

                if (!Boton) {
                    return;
                }

                document.getElementById("IdCategoriaEditar").value =
                    Boton.getAttribute("data-id");

                document.getElementById("NombreCategoriaEditar").value =
                    Boton.getAttribute("data-nombre");

                document.getElementById("DescripcionEditar").value =
                    Boton.getAttribute("data-descripcion") || "";
            });
        })();
    </script>
}
