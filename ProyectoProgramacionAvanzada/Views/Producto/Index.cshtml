@model ProyectoProgramacionAvanzada.Models.ListadoProductosViewModel

@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Gestión de productos</h1>
        <p class="text-muted m-0">
            Catálogo de la tienda: creación, edición, inventario e imágenes.
        </p>
    </div>

    <a href="@Url.Action("Crear", "Producto")" class="btn btn-dark">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
        Nuevo producto
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensajeExito"]
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-warning" role="alert">
        @TempData["MensajeError"]
    </div>
}

@if (Model.AlertasBajoStock.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
            Alerta de bajo inventario:
        </strong>

        @foreach (var Alerta in Model.AlertasBajoStock)
        {
            <span class="badge bg-danger ms-1">
                @Alerta.NombreProducto (@Alerta.Stock)
            </span>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "Producto")" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label" for="busqueda">Buscar</label>
                <input type="text"
                       class="form-control"
                       id="busqueda"
                       name="busqueda"
                       value="@Model.Busqueda"
                       placeholder="Nombre del producto" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" for="idCategoria">Categoría</label>
                <select class="form-select" id="idCategoria" name="idCategoria">
                    <option value="">Todas</option>
                    @foreach (var Categoria in Model.Categorias)
                    {
                        <option value="@Categoria.Value"
                                @(Model.IdCategoria.HasValue
                                  && Model.IdCategoria.Value.ToString() == Categoria.Value
                                    ? "selected"
                                    : "")>
                            @Categoria.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3 d-grid">
                <button type="submit" class="btn btn-outline-dark">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>
                    Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Productos.Count == 0)
{
    <div class="text-center py-5 border rounded">
        <h2 class="h5 pb-2">No se encontraron productos</h2>
        <p class="text-muted m-0">
            Ajuste los filtros o registre un nuevo producto.
        </p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col">Categoría</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col" class="text-center">Stock</th>
                        <th scope="col" class="text-center">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Producto in Model.Productos)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Producto.RutaImagen) ? "Content/Images/logo.jpeg" : Producto.RutaImagen))"
                                         alt="@Producto.NombreProducto"
                                         class="rounded"
                                         style="width:44px;height:44px;object-fit:cover;" />
                                    <div>
                                        <strong>@Producto.NombreProducto</strong>
                                        @if (Producto.EsPiezaUnica)
                                        {
                                            <span class="badge bg-info text-dark ms-1">Pieza única</span>
                                        }
                                        @if (Producto.Destacado)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Destacado</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@Producto.NombreCategoria</td>
                            <td class="text-end">₡@Producto.Precio.ToString("N2")</td>
                            <td class="text-center">
                                @using (Html.BeginForm(
                                    "ActualizarStock",
                                    "Producto",
                                    FormMethod.Post,
                                    new { @class = "d-inline-flex align-items-center gap-1 justify-content-center" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Producto.IdProducto" />
                                    <input type="number"
                                           class="form-control form-control-sm text-center"
                                           style="width:80px;"
                                           name="stock"
                                           min="0"
                                           value="@Producto.Stock"
                                           aria-label="Stock de @Producto.NombreProducto" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary"
                                            title="Actualizar inventario">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                    </button>
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    string ClaseEstado = "bg-light text-dark";

                                    switch (Producto.NombreEstado)
                                    {
                                        case "Disponible":
                                            ClaseEstado = "bg-success";
                                            break;
                                        case "Agotado":
                                            ClaseEstado = "bg-warning text-dark";
                                            break;
                                        case "Inactivo":
                                            ClaseEstado = "bg-secondary";
                                            break;
                                    }
                                }
                                <span class="badge @ClaseEstado">@Producto.NombreEstado</span>
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Editar", "Producto", new { id = Producto.IdProducto })"
                                   class="btn btn-sm btn-outline-dark"
                                   title="Editar producto">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>

                                <a href="@Url.Action("Imagenes", "Producto", new { id = Producto.IdProducto })"
                                   class="btn btn-sm btn-outline-dark"
                                   title="Imágenes del producto">
                                    <i class="bi bi-images" aria-hidden="true"></i>
                                </a>

                                @using (Html.BeginForm(
                                    "CambiarEstado",
                                    "Producto",
                                    FormMethod.Post,
                                    new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Producto.IdProducto" />
                                    <button type="submit"
                                            class="btn btn-sm @(Producto.NombreEstado == "Inactivo" ? "btn-outline-success" : "btn-outline-danger")"
                                            title="@(Producto.NombreEstado == "Inactivo" ? "Activar producto" : "Desactivar producto")">
                                        <i class="bi @(Producto.NombreEstado == "Inactivo" ? "bi-arrow-counterclockwise" : "bi-slash-circle")"
                                           aria-hidden="true"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de productos" class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int Pagina = 1; Pagina <= Model.TotalPaginas; Pagina++)
                {
                    <li class="page-item @(Pagina == Model.PaginaActual ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "Producto", new
                                 {
                                     busqueda = Model.Busqueda,
                                     idCategoria = Model.IdCategoria,
                                     pagina = Pagina
                                 })">
                            @Pagina
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
