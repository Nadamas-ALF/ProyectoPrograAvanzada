@model ProyectoProgramacionAvanzada.Models.ProductoFormViewModel

@{
    ViewBag.Title = "Nuevo producto";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Nuevo producto</h1>
    <p class="text-muted m-0">
        Complete los datos del producto. Luego podrá agregar sus imágenes.
    </p>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Crear", "Producto", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "alert alert-warning" })

            <div class="row g-3">
                <div class="col-12 col-md-8">
                    @Html.LabelFor(Modelo => Modelo.NombreProducto, new { @class = "form-label" })
                    @Html.TextBoxFor(Modelo => Modelo.NombreProducto, new { @class = "form-control", maxlength = 150 })
                    @Html.ValidationMessageFor(Modelo => Modelo.NombreProducto, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 col-md-4">
                    @Html.LabelFor(Modelo => Modelo.IdCategoria, new { @class = "form-label" })
                    @Html.DropDownListFor(
                        Modelo => Modelo.IdCategoria,
                        Model.Categorias,
                        "Seleccione una categoría",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(Modelo => Modelo.IdCategoria, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(Modelo => Modelo.Descripcion, new { @class = "form-label" })
                    @Html.TextAreaFor(Modelo => Modelo.Descripcion, new { @class = "form-control", rows = 4 })
                </div>

                <div class="col-6 col-md-3">
                    @Html.LabelFor(Modelo => Modelo.Precio, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        @Html.TextBoxFor(
                            Modelo => Modelo.Precio,
                            new { @class = "form-control", type = "number", step = "0.01", min = "500" })
                    </div>
                    @Html.ValidationMessageFor(Modelo => Modelo.Precio, "", new { @class = "text-danger small" })
                </div>

                <div class="col-6 col-md-3">
                    @Html.LabelFor(Modelo => Modelo.Stock, new { @class = "form-label" })
                    @Html.TextBoxFor(
                        Modelo => Modelo.Stock,
                        new { @class = "form-control", type = "number", min = "1" })
                    @Html.ValidationMessageFor(Modelo => Modelo.Stock, "", new { @class = "text-danger small" })
                </div>

                <div class="col-6 col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        @Html.CheckBoxFor(Modelo => Modelo.EsPiezaUnica, new { @class = "form-check-input" })
                        @Html.LabelFor(Modelo => Modelo.EsPiezaUnica, new { @class = "form-check-label" })
                    </div>
                </div>

                <div class="col-6 col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        @Html.CheckBoxFor(Modelo => Modelo.Destacado, new { @class = "form-check-input" })
                        @Html.LabelFor(Modelo => Modelo.Destacado, new { @class = "form-check-label" })
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-dark px-4">
                    Guardar producto
                </button>

                <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-secondary">
                    Cancelar
                </a>
            </div>
        }
    </div>
</div>
