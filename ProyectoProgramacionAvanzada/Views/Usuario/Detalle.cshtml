@model ProyectoProgramacionAvanzada.Models.UsuarioModel

@using ProyectoProgramacionAvanzada.Models
@using System
@using System.Collections.Generic
@using System.Web.Mvc

@{
    ViewBag.Title = "Detalle del usuario";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";

    List<DireccionModel> Direcciones =
        ViewBag.Direcciones as List<DireccionModel>
        ?? new List<DireccionModel>();

    SelectList Roles = ViewBag.Roles as SelectList;
    SelectList Estados = ViewBag.Estados as SelectList;
    SelectList Provincias = ViewBag.Provincias as SelectList;

    string Iniciales =
        (!string.IsNullOrWhiteSpace(Model.Nombre)
            ? Model.Nombre.Substring(0, 1)
            : "") +
        (!string.IsNullOrWhiteSpace(Model.Apellido)
            ? Model.Apellido.Substring(0, 1)
            : "");
}

<header class="page-heading mb-4">

    <div class="page-heading-copy">

        <span class="page-icon">
            <i class="bi bi-person-badge"
               aria-hidden="true"></i>
        </span>

        <div>
            <p class="eyebrow mb-1">
                Administración de usuarios
            </p>

            <h1 class="h3 mb-1">
                Detalle del usuario
            </h1>

            <p class="text-muted mb-0">
                Administra la información, contraseña y direcciones
                asociadas al usuario.
            </p>
        </div>

    </div>

</header>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"
           aria-hidden="true"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-circle me-2"
           aria-hidden="true"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger"
         role="alert">

        @Html.ValidationSummary(
            false,
            "",
            new { @class = "mb-0" }
        )

    </div>
}

<section class="row g-4">

    <div class="col-12 col-xl-4">

        <article class="panel h-100 text-center">

            <span class="profile-avatar avatar-xl mx-auto mb-3">
                @Iniciales.ToUpper()
            </span>

            <h2 class="h4 mb-1">
                @Model.Nombre @Model.Apellido
            </h2>

            <p class="text-muted mb-3">
                @Model.Email
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">

                <span class="badge bg-primary">
                    @Model.NombreRol
                </span>

                @if (string.Equals(
                    Model.NombreEstado,
                    "Activo",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <span class="badge bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.NombreEstado
                    </span>
                }

            </div>

            <div class="text-start border-top pt-3">

                <p class="mb-2">

                    <strong>Cédula:</strong>

                    @(string.IsNullOrWhiteSpace(Model.Cedula)
                        ? "No registrada"
                        : Model.Cedula)

                </p>

                <p class="mb-2">

                    <strong>Teléfono:</strong>

                    @(string.IsNullOrWhiteSpace(Model.Telefono)
                        ? "No registrado"
                        : Model.Telefono)

                </p>

                <p class="mb-0">

                    <strong>Fecha de registro:</strong>

                    @Model.FechaRegistro.ToString("dd/MM/yyyy")

                </p>

            </div>

        </article>

    </div>

    <div class="col-12 col-xl-8">

        <article class="panel h-100">

            <div class="panel-header">

                <div>

                    <h2 class="h5 mb-1">
                        Información del usuario
                    </h2>

                    <p class="text-muted mb-0">
                        Modifica los datos generales de la cuenta.
                    </p>

                </div>

            </div>

            @using (Html.BeginForm(
                "ActualizarUsuario",
                "Usuario",
                FormMethod.Post,
                new { @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(Modelo => Modelo.IdUsuario)

                <div class="row g-3">

                    <div class="col-12 col-md-6">

                        @Html.LabelFor(
                            Modelo => Modelo.Nombre,
                            new { @class = "form-label" }
                        )

                        @Html.TextBoxFor(
                            Modelo => Modelo.Nombre,
                            new
                            {
                                @class = "form-control",
                                maxlength = "100"
                            }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.Nombre,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12 col-md-6">

                        @Html.LabelFor(
                            Modelo => Modelo.Apellido,
                            new { @class = "form-label" }
                        )

                        @Html.TextBoxFor(
                            Modelo => Modelo.Apellido,
                            new
                            {
                                @class = "form-control",
                                maxlength = "100"
                            }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.Apellido,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12 col-md-6">

                        @Html.LabelFor(
                            Modelo => Modelo.Cedula,
                            new { @class = "form-label" }
                        )

                        @Html.TextBoxFor(
                            Modelo => Modelo.Cedula,
                            new
                            {
                                @class = "form-control",
                                maxlength = "20"
                            }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.Cedula,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12 col-md-6">

                        @Html.LabelFor(
                            Modelo => Modelo.Telefono,
                            new { @class = "form-label" }
                        )

                        @Html.TextBoxFor(
                            Modelo => Modelo.Telefono,
                            new
                            {
                                @class = "form-control",
                                maxlength = "20",
                                type = "tel"
                            }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.Telefono,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12">

                        @Html.LabelFor(
                            Modelo => Modelo.Email,
                            new { @class = "form-label" }
                        )

                        @Html.TextBoxFor(
                            Modelo => Modelo.Email,
                            new
                            {
                                @class = "form-control",
                                maxlength = "150",
                                type = "email"
                            }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.Email,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12 col-md-6">

                        <label class="form-label"
                               for="IdRol">
                            Rol
                        </label>

                        @Html.DropDownListFor(
                            Modelo => Modelo.IdRol,
                            Roles,
                            "Seleccione un rol",
                            new { @class = "form-select" }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.IdRol,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12 col-md-6">

                        <label class="form-label"
                               for="IdEstado">
                            Estado
                        </label>

                        @Html.DropDownListFor(
                            Modelo => Modelo.IdEstado,
                            Estados,
                            "Seleccione un estado",
                            new { @class = "form-select" }
                        )

                        @Html.ValidationMessageFor(
                            Modelo => Modelo.IdEstado,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                    <div class="col-12 text-end">

                        <button class="btn btn-primary"
                                type="submit">

                            <i class="bi bi-floppy me-1"
                               aria-hidden="true"></i>

                            Guardar cambios

                        </button>

                    </div>

                </div>
            }

        </article>

    </div>

</section>

<section class="panel mt-4"
         id="Seguridad">

    <div class="panel-header">

        <div>

            <h2 class="h5 mb-1">

                <i class="bi bi-shield-lock me-2"
                   aria-hidden="true"></i>

                Restablecer contraseña

            </h2>

            <p class="text-muted mb-0">
                Asigna una contraseña nueva al usuario.
            </p>

        </div>

    </div>

    @using (Html.BeginForm(
        "RestablecerContrasenna",
        "Usuario",
        FormMethod.Post,
        new { @class = "needs-validation" }))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="IdUsuario"
               value="@Model.IdUsuario" />

        <div class="row g-3">

            <div class="col-12 col-md-6">

                <label class="form-label"
                       for="Contrasenna">
                    Nueva contraseña
                </label>

                <div class="input-group">

                    <input class="form-control"
                           id="Contrasenna"
                           name="Contrasenna"
                           type="password"
                           minlength="8"
                           maxlength="255"
                           autocomplete="new-password"
                           required />

                    <button class="btn btn-outline-secondary"
                            type="button"
                            data-password-toggle="Contrasenna"
                            aria-label="Mostrar u ocultar contraseña">

                        <i class="bi bi-eye"
                           aria-hidden="true"></i>

                    </button>

                </div>

            </div>

            <div class="col-12 col-md-6">

                <label class="form-label"
                       for="ConfirmarContrasenna">
                    Confirmar contraseña
                </label>

                <div class="input-group">

                    <input class="form-control"
                           id="ConfirmarContrasenna"
                           name="ConfirmarContrasenna"
                           type="password"
                           minlength="8"
                           maxlength="255"
                           autocomplete="new-password"
                           required />

                    <button class="btn btn-outline-secondary"
                            type="button"
                            data-password-toggle="ConfirmarContrasenna"
                            aria-label="Mostrar u ocultar contraseña">

                        <i class="bi bi-eye"
                           aria-hidden="true"></i>

                    </button>

                </div>

            </div>

            <div class="col-12">

                <div class="alert alert-warning mb-0">

                    <i class="bi bi-exclamation-triangle me-2"
                       aria-hidden="true"></i>

                    La contraseña anterior dejará de funcionar
                    inmediatamente.

                </div>

            </div>

            <div class="col-12 text-end">

                <button class="btn btn-warning"
                        type="submit">

                    <i class="bi bi-key me-1"
                       aria-hidden="true"></i>

                    Restablecer contraseña

                </button>

            </div>

        </div>
    }

</section>

<section class="panel mt-4"
         id="Direcciones">

    <div class="panel-header d-flex flex-wrap justify-content-between gap-3">

        <div>

            <h2 class="h5 mb-1">

                <i class="bi bi-geo-alt me-2"
                   aria-hidden="true"></i>

                Direcciones de envío

            </h2>

            <p class="text-muted mb-0">
                Administra las direcciones asociadas al usuario.
            </p>

        </div>

        <button class="btn btn-primary"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#ModalAgregarDireccion">

            <i class="bi bi-plus-lg me-1"
               aria-hidden="true"></i>

            Agregar dirección

        </button>

    </div>

    <div class="table-responsive">

        <table class="table align-middle mb-0">

            <thead>

                <tr>
                    <th>Destinatario</th>
                    <th>Ubicación</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Principal</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>

            </thead>

            <tbody>

                @if (Direcciones.Count == 0)
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted py-5">

                            <i class="bi bi-geo-alt fs-3 d-block mb-2"
                               aria-hidden="true"></i>

                            El usuario no tiene direcciones registradas.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (DireccionModel Direccion in Direcciones)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @Direccion.NombreDestinatario
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(
                                    Direccion.Referencia))
                                {
                                    <small class="d-block text-muted">
                                        @Direccion.Referencia
                                    </small>
                                }

                            </td>

                            <td>

                                <span class="d-block">
                                    @Direccion.NombreProvincia
                                </span>

                                <small class="text-muted">
                                    @Direccion.NombreCanton,
                                    @Direccion.NombreDistrito
                                </small>

                            </td>

                            <td>
                                @Direccion.DireccionExacta
                            </td>

                            <td>
                                @Direccion.TelefonoContacto
                            </td>

                            <td>

                                @if (Direccion.EsPrincipal)
                                {
                                    <span class="badge bg-primary">
                                        Principal
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No
                                    </span>
                                }

                            </td>

                            <td>

                                @if (string.Equals(
                                    Direccion.NombreEstado,
                                    "Activo",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactiva
                                    </span>
                                }

                            </td>

                            <td class="text-end text-nowrap">

                                <button type="button"
                                        class="btn btn-outline-primary btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#ModalEditarDireccion-@Direccion.IdDireccion">

                                    <i class="bi bi-pencil"
                                       aria-hidden="true"></i>

                                    Editar

                                </button>

                                @if (string.Equals(
                                    Direccion.NombreEstado,
                                    "Activo",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    using (Html.BeginForm(
                                        "DesactivarDireccion",
                                        "Usuario",
                                        FormMethod.Post,
                                        new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="IdDireccion"
                                               value="@Direccion.IdDireccion" />

                                        <input type="hidden"
                                               name="IdUsuario"
                                               value="@Direccion.IdUsuario" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('¿Desea desactivar esta dirección?');">

                                            <i class="bi bi-x-circle"
                                               aria-hidden="true"></i>

                                            Desactivar

                                        </button>
                                    }
                                }

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</section>

<div class="modal fade"
     id="ModalAgregarDireccion"
     tabindex="-1"
     aria-labelledby="TituloModalAgregarDireccion"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            @using (Html.BeginForm(
                "AgregarDireccion",
                "Usuario",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="IdUsuario"
                       value="@Model.IdUsuario" />

                <div class="modal-header">

                    <h2 class="modal-title fs-5"
                        id="TituloModalAgregarDireccion">
                        Agregar dirección
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-12 col-md-6">

                            <label class="form-label"
                                   for="AgregarNombreDestinatario">
                                Nombre del destinatario
                            </label>

                            <input class="form-control"
                                   id="AgregarNombreDestinatario"
                                   name="NombreDestinatario"
                                   maxlength="150"
                                   required />

                        </div>

                        <div class="col-12 col-md-6">

                            <label class="form-label"
                                   for="AgregarTelefonoContacto">
                                Teléfono de contacto
                            </label>

                            <input class="form-control"
                                   id="AgregarTelefonoContacto"
                                   name="TelefonoContacto"
                                   type="tel"
                                   maxlength="20"
                                   required />

                        </div>

                        <div class="col-12 col-md-4">

                            <label class="form-label"
                                   for="AgregarProvincia">
                                Provincia
                            </label>

                            @Html.DropDownList(
                                "AgregarProvincia",
                                Provincias,
                                "Seleccione una provincia",
                                new
                                {
                                    @class = "form-select",
                                    id = "AgregarProvincia",
                                    required = "required"
                                }
                            )

                        </div>

                        <div class="col-12 col-md-4">

                            <label class="form-label"
                                   for="AgregarCanton">
                                Cantón
                            </label>

                            <select class="form-select"
                                    id="AgregarCanton"
                                    disabled
                                    required>

                                <option value="">
                                    Seleccione un cantón
                                </option>

                            </select>

                        </div>

                        <div class="col-12 col-md-4">

                            <label class="form-label"
                                   for="AgregarDistrito">
                                Distrito
                            </label>

                            <select class="form-select"
                                    id="AgregarDistrito"
                                    name="IdDistrito"
                                    disabled
                                    required>

                                <option value="">
                                    Seleccione un distrito
                                </option>

                            </select>

                        </div>

                        <div class="col-12">

                            <label class="form-label"
                                   for="AgregarDireccionExacta">
                                Dirección exacta
                            </label>

                            <textarea class="form-control"
                                      id="AgregarDireccionExacta"
                                      name="DireccionExacta"
                                      rows="3"
                                      maxlength="300"
                                      required></textarea>

                        </div>

                        <div class="col-12">

                            <label class="form-label"
                                   for="AgregarReferencia">
                                Referencia
                            </label>

                            <textarea class="form-control"
                                      id="AgregarReferencia"
                                      name="Referencia"
                                      rows="2"
                                      maxlength="300"></textarea>

                        </div>

                        <div class="col-12">

                            <div class="form-check">

                                <input class="form-check-input"
                                       id="AgregarEsPrincipal"
                                       name="EsPrincipal"
                                       type="checkbox"
                                       value="true" />

                                <input name="EsPrincipal"
                                       type="hidden"
                                       value="false" />

                                <label class="form-check-label"
                                       for="AgregarEsPrincipal">

                                    Establecer como dirección principal

                                </label>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-floppy me-1"
                           aria-hidden="true"></i>

                        Guardar dirección

                    </button>

                </div>
            }

        </div>

    </div>

</div>

@foreach (DireccionModel Direccion in Direcciones)
{
    <div class="modal fade"
         id="ModalEditarDireccion-@Direccion.IdDireccion"
         tabindex="-1"
         aria-labelledby="TituloModalEditarDireccion-@Direccion.IdDireccion"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                @using (Html.BeginForm(
                    "ActualizarDireccion",
                    "Usuario",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="IdDireccion"
                           value="@Direccion.IdDireccion" />

                    <input type="hidden"
                           name="IdUsuario"
                           value="@Direccion.IdUsuario" />

                    <div class="modal-header">

                        <h2 class="modal-title fs-5"
                            id="TituloModalEditarDireccion-@Direccion.IdDireccion">
                            Editar dirección
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="row g-3">

                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Nombre del destinatario
                                </label>

                                <input class="form-control"
                                       name="NombreDestinatario"
                                       value="@Direccion.NombreDestinatario"
                                       maxlength="150"
                                       required />

                            </div>

                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Teléfono de contacto
                                </label>

                                <input class="form-control"
                                       name="TelefonoContacto"
                                       value="@Direccion.TelefonoContacto"
                                       maxlength="20"
                                       required />

                            </div>

                            <div class="col-12 col-md-4">

                                <label class="form-label">
                                    Provincia
                                </label>

                                <select class="form-select editar-provincia"
                                        data-direccion="@Direccion.IdDireccion"
                                        required>

                                    <option value="">
                                        Seleccione una provincia
                                    </option>

                                    @if (Provincias != null)
                                    {
                                        foreach (SelectListItem Provincia in Provincias)
                                        {
                                            bool Seleccionada =
                                                Provincia.Value ==
                                                Direccion.IdProvincia.ToString();

                                            <option value="@Provincia.Value"
                                                    selected="@Seleccionada">
                                                @Provincia.Text
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                            <div class="col-12 col-md-4">

                                <label class="form-label">
                                    Cantón
                                </label>

                                <select class="form-select editar-canton"
                                        data-direccion="@Direccion.IdDireccion"
                                        data-seleccionado="@Direccion.IdCanton"
                                        required>

                                    <option value="">
                                        Seleccione un cantón
                                    </option>

                                </select>

                            </div>

                            <div class="col-12 col-md-4">

                                <label class="form-label">
                                    Distrito
                                </label>

                                <select class="form-select editar-distrito"
                                        name="IdDistrito"
                                        data-direccion="@Direccion.IdDireccion"
                                        data-seleccionado="@Direccion.IdDistrito"
                                        required>

                                    <option value="">
                                        Seleccione un distrito
                                    </option>

                                </select>

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Dirección exacta
                                </label>

                                <textarea class="form-control"
                                          name="DireccionExacta"
                                          rows="3"
                                          maxlength="300"
                                          required>@Direccion.DireccionExacta</textarea>

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Referencia
                                </label>

                                <textarea class="form-control"
                                          name="Referencia"
                                          rows="2"
                                          maxlength="300">@Direccion.Referencia</textarea>

                            </div>

                            <div class="col-12">

                                <div class="form-check">

                                    @if (Direccion.EsPrincipal)
                                    {
                                        <input class="form-check-input"
                                               id="EditarEsPrincipal-@Direccion.IdDireccion"
                                               name="EsPrincipal"
                                               type="checkbox"
                                               value="true"
                                               checked />
                                    }
                                    else
                                    {
                                        <input class="form-check-input"
                                               id="EditarEsPrincipal-@Direccion.IdDireccion"
                                               name="EsPrincipal"
                                               type="checkbox"
                                               value="true" />
                                    }

                                    <input name="EsPrincipal"
                                           type="hidden"
                                           value="false" />

                                    <label class="form-check-label"
                                           for="EditarEsPrincipal-@Direccion.IdDireccion">

                                        Establecer como dirección principal

                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-floppy me-1"
                               aria-hidden="true"></i>

                            Guardar cambios

                        </button>

                    </div>
                }

            </div>

        </div>

    </div>
}

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const UrlCantones =
                '@Url.Action("ConsultarCantones", "Usuario")';

            const UrlDistritos =
                '@Url.Action("ConsultarDistritos", "Usuario")';

            async function CargarCantones(
                IdProvincia,
                SelectorCanton,
                IdCantonSeleccionado
            ) {
                SelectorCanton.innerHTML =
                    '<option value="">Seleccione un cantón</option>';

                SelectorCanton.disabled = true;

                if (!IdProvincia) {
                    return;
                }

                try {
                    const Respuesta = await fetch(
                        UrlCantones +
                        "?IdProvincia=" +
                        encodeURIComponent(IdProvincia)
                    );

                    if (!Respuesta.ok) {
                        throw new Error(
                            "No fue posible consultar los cantones."
                        );
                    }

                    const Cantones = await Respuesta.json();

                    Cantones.forEach(function (Canton) {

                        const Opcion =
                            document.createElement("option");

                        Opcion.value = Canton.IdCanton;
                        Opcion.textContent = Canton.NombreCanton;

                        if (
                            IdCantonSeleccionado &&
                            String(Canton.IdCanton) ===
                            String(IdCantonSeleccionado)
                        ) {
                            Opcion.selected = true;
                        }

                        SelectorCanton.appendChild(Opcion);
                    });

                    SelectorCanton.disabled = false;
                }
                catch (Error) {
                    console.error(Error);

                    SelectorCanton.innerHTML =
                        '<option value="">Error al cargar</option>';
                }
            }

            async function CargarDistritos(
                IdCanton,
                SelectorDistrito,
                IdDistritoSeleccionado
            ) {
                SelectorDistrito.innerHTML =
                    '<option value="">Seleccione un distrito</option>';

                SelectorDistrito.disabled = true;

                if (!IdCanton) {
                    return;
                }

                try {
                    const Respuesta = await fetch(
                        UrlDistritos +
                        "?IdCanton=" +
                        encodeURIComponent(IdCanton)
                    );

                    if (!Respuesta.ok) {
                        throw new Error(
                            "No fue posible consultar los distritos."
                        );
                    }

                    const Distritos = await Respuesta.json();

                    Distritos.forEach(function (Distrito) {

                        const Opcion =
                            document.createElement("option");

                        Opcion.value = Distrito.IdDistrito;
                        Opcion.textContent =
                            Distrito.NombreDistrito;

                        if (
                            IdDistritoSeleccionado &&
                            String(Distrito.IdDistrito) ===
                            String(IdDistritoSeleccionado)
                        ) {
                            Opcion.selected = true;
                        }

                        SelectorDistrito.appendChild(Opcion);
                    });

                    SelectorDistrito.disabled = false;
                }
                catch (Error) {
                    console.error(Error);

                    SelectorDistrito.innerHTML =
                        '<option value="">Error al cargar</option>';
                }
            }

            const AgregarProvincia =
                document.getElementById("AgregarProvincia");

            const AgregarCanton =
                document.getElementById("AgregarCanton");

            const AgregarDistrito =
                document.getElementById("AgregarDistrito");

            if (
                AgregarProvincia &&
                AgregarCanton &&
                AgregarDistrito
            ) {
                AgregarProvincia.addEventListener(
                    "change",
                    async function () {

                        await CargarCantones(
                            this.value,
                            AgregarCanton,
                            null
                        );

                        AgregarDistrito.innerHTML =
                            '<option value="">Seleccione un distrito</option>';

                        AgregarDistrito.disabled = true;
                    }
                );

                AgregarCanton.addEventListener(
                    "change",
                    async function () {

                        await CargarDistritos(
                            this.value,
                            AgregarDistrito,
                            null
                        );
                    }
                );
            }

            document
                .querySelectorAll(".editar-provincia")
                .forEach(async function (SelectorProvincia) {

                    const IdDireccion =
                        SelectorProvincia.dataset.direccion;

                    const SelectorCanton =
                        document.querySelector(
                            '.editar-canton[data-direccion="' +
                            IdDireccion +
                            '"]'
                        );

                    const SelectorDistrito =
                        document.querySelector(
                            '.editar-distrito[data-direccion="' +
                            IdDireccion +
                            '"]'
                        );

                    if (!SelectorCanton || !SelectorDistrito) {
                        return;
                    }

                    const IdCantonSeleccionado =
                        SelectorCanton.dataset.seleccionado;

                    const IdDistritoSeleccionado =
                        SelectorDistrito.dataset.seleccionado;

                    await CargarCantones(
                        SelectorProvincia.value,
                        SelectorCanton,
                        IdCantonSeleccionado
                    );

                    await CargarDistritos(
                        SelectorCanton.value,
                        SelectorDistrito,
                        IdDistritoSeleccionado
                    );

                    SelectorProvincia.addEventListener(
                        "change",
                        async function () {

                            await CargarCantones(
                                this.value,
                                SelectorCanton,
                                null
                            );

                            SelectorDistrito.innerHTML =
                                '<option value="">Seleccione un distrito</option>';

                            SelectorDistrito.disabled = true;
                        }
                    );

                    SelectorCanton.addEventListener(
                        "change",
                        async function () {

                            await CargarDistritos(
                                this.value,
                                SelectorDistrito,
                                null
                            );
                        }
                    );
                });

            document
                .querySelectorAll("[data-password-toggle]")
                .forEach(function (Boton) {

                    Boton.addEventListener(
                        "click",
                        function () {

                            const IdCampo =
                                this.dataset.passwordToggle;

                            const Campo =
                                document.getElementById(IdCampo);

                            const Icono =
                                this.querySelector("i");

                            if (!Campo || !Icono) {
                                return;
                            }

                            if (Campo.type === "password") {
                                Campo.type = "text";
                                Icono.className =
                                    "bi bi-eye-slash";
                            }
                            else {
                                Campo.type = "password";
                                Icono.className =
                                    "bi bi-eye";
                            }
                        }
                    );
                });

        });
    </script>
}