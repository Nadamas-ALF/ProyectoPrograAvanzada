@model ProyectoProgramacionAvanzada.Models.ListadoPedidosAdminViewModel

@{
    ViewBag.Title = "Pedidos";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

@helper BadgeEstado(string NombreEstado)
{
    var Clase = "bg-light text-dark";

    switch (NombreEstado)
    {
        case "Pagado":
            Clase = "bg-success";
            break;
        case "En preparación":
            Clase = "bg-warning text-dark";
            break;
        case "Entregado":
            Clase = "bg-secondary";
            break;
        case "Cancelado":
            Clase = "bg-danger";
            break;
    }

    <span class="badge @Clase">@NombreEstado</span>
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Gestión de pedidos</h1>
    <p class="text-muted m-0">
        Preparación y seguimiento de las ventas de la tienda.
    </p>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensajeExito"]
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-warning" role="alert">
        @TempData["MensajeError"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "PedidoAdmin")" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="busqueda">Buscar</label>
                <input type="text"
                       class="form-control"
                       id="busqueda"
                       name="busqueda"
                       value="@Model.Busqueda"
                       placeholder="Cliente, correo o factura" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label" for="idEstado">Estado</label>
                <select class="form-select" id="idEstado" name="idEstado">
                    <option value="">Todos</option>
                    @foreach (var Estado in Model.Estados)
                    {
                        <option value="@Estado.Value"
                                @(Model.IdEstado.HasValue
                                  && Model.IdEstado.Value.ToString() == Estado.Value
                                    ? "selected"
                                    : "")>
                            @Estado.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label" for="fechaInicio">Desde</label>
                <input type="date"
                       class="form-control"
                       id="fechaInicio"
                       name="fechaInicio"
                       value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label" for="fechaFin">Hasta</label>
                <input type="date"
                       class="form-control"
                       id="fechaFin"
                       name="fechaFin"
                       value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-6 col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-dark">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>
                    Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Pedidos.Count == 0)
{
    <div class="text-center py-5 border rounded">
        <h2 class="h5 pb-2">No se encontraron pedidos</h2>
        <p class="text-muted m-0">
            Ajuste los filtros de búsqueda.
        </p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Factura</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Fecha</th>
                        <th scope="col" class="text-center">Productos</th>
                        <th scope="col" class="text-end">Total</th>
                        <th scope="col" class="text-center">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Pedido in Model.Pedidos)
                    {
                        <tr>
                            <td><strong>@(Pedido.NumeroFactura ?? ("Pedido #" + Pedido.IdPedido))</strong></td>
                            <td>
                                @Pedido.NombreCliente
                                <br />
                                <small class="text-muted">@Pedido.EmailCliente</small>
                            </td>
                            <td>@Pedido.FechaPedido.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td class="text-center">@Pedido.CantidadProductos</td>
                            <td class="text-end">₡@Pedido.Total.ToString("N2")</td>
                            <td class="text-center">@BadgeEstado(Pedido.NombreEstado)</td>
                            <td class="text-end">
                                <a href="@Url.Action("Detalle", "PedidoAdmin", new { id = Pedido.IdPedido })"
                                   class="btn btn-sm btn-outline-dark">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de pedidos" class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int Pagina = 1; Pagina <= Model.TotalPaginas; Pagina++)
                {
                    <li class="page-item @(Pagina == Model.PaginaActual ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "PedidoAdmin", new
                                 {
                                     busqueda = Model.Busqueda,
                                     idEstado = Model.IdEstado,
                                     fechaInicio = Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : null,
                                     fechaFin = Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : null,
                                     pagina = Pagina
                                 })">
                            @Pagina
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
