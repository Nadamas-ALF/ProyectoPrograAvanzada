@model ProyectoProgramacionAvanzada.Models.PortadaViewModel

<section id="len-hero" class="len-hero">
    <div class="container-lg">
        <h1 class="visually-hidden">LEN Accesorios — charms y accesorios para bolso</h1>

        <img src="~/Content/Images/logo.jpeg"
             alt="LEN — Modern Bag Charm"
             class="len-hero-logo"
             width="815" height="476">

        <hr class="len-hero-separador">

        <p class="len-hero-lema">
            Charms y accesorios para bolso, hechos para acompañarte.
            Envíos a todo Costa Rica.
        </p>

        <a href="@Url.Action("Index", "Catalogo")" class="len-hero-cta">Ver catálogo</a>
    </div>
</section>


@if (Model.Destacados.Count > 0)
{
    <section id="intro" class="len-seccion position-relative">
        <div class="container-lg">
            <div class="portada-carrusel">
                <div class="swiper portada-swiper">
                    <div class="swiper-wrapper">
                        @foreach (var Destacado in Model.Destacados)
                        {
                            <div class="swiper-slide">
                                <a href="@Url.Action("Detalle", "Catalogo", new { id = Destacado.IdProducto })"
                                   class="hero-slide text-decoration-none"
                                   aria-label="Ver detalle de @Destacado.NombreProducto">
                                    <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Destacado.RutaImagen) ? "Content/Images/logo.jpeg" : Destacado.RutaImagen))"
                                         alt="@Destacado.NombreProducto"
                                         class="hero-imagen">
                                    <div class="len-hero-info">
                                        <p class="len-hero-categoria">@Destacado.NombreCategoria</p>
                                        <h2 class="len-hero-nombre">@Destacado.NombreProducto</h2>
                                        <span class="len-hero-precio">@string.Format("₡{0:N2}", Destacado.Precio)</span>
                                        <span class="len-hero-enlace">Ver producto</span>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <button type="button" class="portada-flecha portada-flecha-anterior" aria-label="Producto anterior">
                    <svg aria-hidden="true" focusable="false">
                        <use xlink:href="#arrow-right"></use>
                    </svg>
                </button>
                <button type="button" class="portada-flecha portada-flecha-siguiente" aria-label="Producto siguiente">
                    <svg aria-hidden="true" focusable="false">
                        <use xlink:href="#arrow-right"></use>
                    </svg>
                </button>
            </div>

            <div class="swiper-pagination portada-paginacion"></div>
        </div>
    </section>
}

@*Productos reales del catálogo (SP_ConsultarCatalogo vía CatalogoService)*@
<section id="featured-products" class="product-store len-seccion">
    <div class="container-md">

        @Html.AntiForgeryToken()
        <div id="alerta-carrito" class="alert d-none" role="alert"></div>

        <div class="display-header d-flex align-items-end justify-content-between">
            <div>
                <h2 class="section-title len-seccion-titulo text-uppercase m-0">Nuestros accesorios</h2>
                <p class="len-seccion-bajada">Piezas hechas a mano para tu bolso, tu llavero y tu día a día.</p>
            </div>
            <div class="btn-right">
                <a href="@Url.Action("Index", "Catalogo")" class="d-inline-block text-uppercase text-hover fw-bold">Ver todo</a>
            </div>
        </div>

        <div class="product-content padding-small">
            @if (Model.Catalogo.Productos.Count == 0)
            {
                <div class="text-center py-5 border rounded">
                    <h3 class="h5 pb-2">No hay productos disponibles por el momento.</h3>
                    <p class="text-muted m-0">Vuelva pronto para descubrir nuestros accesorios.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4">
                    @foreach (var Producto in Model.Catalogo.Productos)
                    {
                        <div class="col mb-4">
                            <div class="product-card position-relative">
                                <div class="card-img">
                                    <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Producto.RutaImagen) ? "Content/Images/logo.jpeg" : Producto.RutaImagen))"
                                         alt="@Producto.NombreProducto"
                                         class="product-image img-fluid img-producto"
                                         loading="lazy">
                                    @if (!Producto.Disponible)
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 start-0 m-2">Agotado</span>
                                    }
                                    <div class="cart-concern position-absolute d-flex justify-content-center">
                                        <div class="cart-button d-flex gap-2 justify-content-center align-items-center">
                                            @if (Producto.Disponible)
                                            {
                                                <button type="button"
                                                        class="btn btn-light js-agregar-portada"
                                                        data-idproducto="@Producto.IdProducto"
                                                        title="Agregar al carrito"
                                                        aria-label="Agregar @Producto.NombreProducto al carrito">
                                                    <svg class="shopping-carriage">
                                                        <use xlink:href="#shopping-carriage"></use>
                                                    </svg>
                                                </button>
                                            }
                                            <a href="@Url.Action("Detalle", "Catalogo", new { id = Producto.IdProducto })"
                                               class="btn btn-light"
                                               title="Ver detalle"
                                               aria-label="Ver detalle de @Producto.NombreProducto">
                                                <svg class="quick-view">
                                                    <use xlink:href="#quick-view"></use>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                    <!-- cart-concern -->
                                </div>
                                <div class="card-detail len-card-detalle">
                                    @if (!string.IsNullOrWhiteSpace(Producto.NombreCategoria))
                                    {
                                        <p class="len-card-categoria">@Producto.NombreCategoria</p>
                                    }
                                    <h3 class="len-card-nombre">
                                        <a href="@Url.Action("Detalle", "Catalogo", new { id = Producto.IdProducto })">@Producto.NombreProducto</a>
                                    </h3>
                                    <span class="len-card-precio">@string.Format("₡{0:N2}", Producto.Precio)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section id="collection-products" class="len-seccion pb-5 mb-md-4">
    <div class="container-md">
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-4">
                <div class="len-coleccion-card">
                    <img src="~/Content/Images/snicker.jpeg"
                         alt="Pulsera de charms en colores pastel con dijes de oso, macaron y control de videojuego"
                         class="len-coleccion-imagen"
                         loading="lazy">
                    <div class="len-coleccion-info">
                        <h3 class="len-coleccion-titulo">
                            <a href="@Url.Action("Index", "Catalogo")">Charms para bolso</a>
                        </h3>
                        <a href="@Url.Action("Index", "Catalogo")" class="len-coleccion-enlace">Ver catálogo</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 mb-4">
                <div class="len-coleccion-card">
                    <img src="~/Content/Images/pato.jpeg"
                         alt="Llavero de patito con cadena dorada colgando de un bolso"
                         class="len-coleccion-imagen"
                         loading="lazy">
                    <div class="len-coleccion-info">
                        <h3 class="len-coleccion-titulo">
                            <a href="@Url.Action("Index", "Catalogo")">Colección LEN</a>
                        </h3>
                        <a href="@Url.Action("Index", "Catalogo")" class="len-coleccion-enlace">Ver catálogo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="@Url.Content("~/Scripts/portada.js")"></script>
    <script src="@Url.Content("~/Scripts/carrito.js")"></script>
    <script>
        $(function () {
            $('.js-agregar-portada').on('click', function () {
                window.LEN_AgregarAlCarrito($(this).data('idproducto'), 1);
            });
        });
    </script>
}
