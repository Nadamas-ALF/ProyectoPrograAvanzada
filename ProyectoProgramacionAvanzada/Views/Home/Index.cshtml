@model ProyectoProgramacionAvanzada.Models.PortadaViewModel

<div class="search-box bg-dark position-relative">
    <div class="search-wrap">
        <div class="close-button">
            <svg class="close" style="fill: white;">
                <use xlink:href="#close"></use>
            </svg>
        </div>
        <form id="search-form" class="text-lg-center text-md-left pt-3" action="@Url.Action("Index", "Catalogo")" method="get">
            <input type="text" name="busqueda" class="search-input" placeholder="Buscar accesorios...">
            <svg class="search">
                <use xlink:href="#search"></use>
            </svg>
        </form>
    </div>
</div>

@*Carrusel de productos destacados (bandera administrada por el módulo de productos).*@
@if (Model.Destacados.Count > 0)
{
    <section id="intro" class="position-relative mt-4">
        <div class="container-lg">
            <div class="swiper main-swiper">
                <div class="swiper-wrapper">
                    @foreach (var Destacado in Model.Destacados)
                    {
                        <div class="swiper-slide">
                            <a href="@Url.Action("Detalle", "Catalogo", new { id = Destacado.IdProducto })"
                               class="hero-slide card d-flex flex-row align-items-end border-0 large text-decoration-none"
                               aria-label="Ver detalle de @Destacado.NombreProducto">
                                <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Destacado.RutaImagen) ? "Content/Images/logo.jpeg" : Destacado.RutaImagen))"
                                     alt="@Destacado.NombreProducto"
                                     class="hero-imagen">
                                <div class="cart-concern p-3 m-3 p-lg-5 m-lg-5">
                                    <p class="text-uppercase light m-0">@Destacado.NombreCategoria</p>
                                    <h2 class="card-title display-4 light">@Destacado.NombreProducto</h2>
                                    <span class="fs-4 fw-bold light d-block">@string.Format("₡{0:N2}", Destacado.Precio)</span>
                                    <span class="text-uppercase light mt-3 d-inline-block text-hover fw-bold light-border">Ver producto</span>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </section>
}

@*Productos reales del catálogo (SP_ConsultarCatalogo vía CatalogoService)*@
<section id="featured-products" class="product-store">
    <div class="container-md">

        @Html.AntiForgeryToken()
        <div id="alerta-carrito" class="alert d-none" role="alert"></div>

        <div class="display-header d-flex align-items-center justify-content-between">
            <h2 class="section-title text-uppercase">Nuestros accesorios</h2>
            <div class="btn-right">
                <a href="@Url.Action("Index", "Catalogo")" class="d-inline-block text-uppercase text-hover fw-bold">Ver todo</a>
            </div>
        </div>

        <div class="product-content padding-small">
            @if (Model.Catalogo.Productos.Count == 0)
            {
                <div class="text-center py-5 border rounded">
                    <h3 class="h5 pb-2">No hay productos disponibles por el momento.</h3>
                    <p class="text-muted m-0">Vuelva pronto para descubrir nuestros accesorios.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5">
                    @foreach (var Producto in Model.Catalogo.Productos)
                    {
                        <div class="col mb-4">
                            <div class="product-card position-relative">
                                <div class="card-img">
                                    <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Producto.RutaImagen) ? "Content/Images/logo.jpeg" : Producto.RutaImagen))"
                                         alt="@Producto.NombreProducto"
                                         class="product-image img-fluid img-producto">
                                    @if (!Producto.Disponible)
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 start-0 m-2">Agotado</span>
                                    }
                                    <div class="cart-concern position-absolute d-flex justify-content-center">
                                        <div class="cart-button d-flex gap-2 justify-content-center align-items-center">
                                            @if (Producto.Disponible)
                                            {
                                                <button type="button"
                                                        class="btn btn-light js-agregar-portada"
                                                        data-idproducto="@Producto.IdProducto"
                                                        title="Agregar al carrito"
                                                        aria-label="Agregar @Producto.NombreProducto al carrito">
                                                    <svg class="shopping-carriage">
                                                        <use xlink:href="#shopping-carriage"></use>
                                                    </svg>
                                                </button>
                                            }
                                            <a href="@Url.Action("Detalle", "Catalogo", new { id = Producto.IdProducto })"
                                               class="btn btn-light"
                                               title="Ver detalle"
                                               aria-label="Ver detalle de @Producto.NombreProducto">
                                                <svg class="quick-view">
                                                    <use xlink:href="#quick-view"></use>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-detail d-flex justify-content-between align-items-center mt-3">
                                    <h3 class="card-title fs-6 fw-normal m-0">
                                        <a href="@Url.Action("Detalle", "Catalogo", new { id = Producto.IdProducto })">@Producto.NombreProducto</a>
                                    </h3>
                                    <span class="card-price fw-bold">@string.Format("₡{0:N2}", Producto.Precio)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section id="collection-products" class="py-2 my-2 py-md-5 my-md-5">
    <div class="container-md">
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-4">
                <div class="collection-card card border-0 d-flex flex-row align-items-end jarallax-keep-img">
                    <img src="~/Content/Images/snicker.jpeg" alt="product-item" class="border-rounded-10 img-fluid jarallax-img">
                    <div class="card-detail p-3 m-3 p-lg-5 m-lg-5">
                        <h3 class="card-title display-3">
                            <a href="@Url.Action("Index", "Catalogo")">Minimal Collection</a>
                        </h3>
                        <a href="@Url.Action("Index", "Catalogo")" class="text-uppercase mt-3 d-inline-block text-hover fw-bold">Ver catálogo</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="collection-card card border-0 d-flex flex-row jarallax-keep-img">
                    <img src="~/Content/Images/pato.jpeg" alt="product-item" class="border-rounded-10 img-fluid jarallax-img">
                    <div class="card-detail p-3 m-3 p-lg-5 m-lg-5">
                        <h3 class="card-title display-3">
                            <a href="@Url.Action("Index", "Catalogo")">Colección LEN</a>
                        </h3>
                        <a href="@Url.Action("Index", "Catalogo")" class="text-uppercase mt-3 d-inline-block text-hover fw-bold">Ver catálogo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="@Url.Content("~/Scripts/carrito.js")"></script>
    <script>
        $(function () {
            $('.js-agregar-portada').on('click', function () {
                window.LEN_AgregarAlCarrito($(this).data('idproducto'), 1);
            });
        });
    </script>
}
