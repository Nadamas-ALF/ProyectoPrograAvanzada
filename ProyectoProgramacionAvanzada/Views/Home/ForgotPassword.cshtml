@model ProyectoProgramacionAvanzada.Models.UsuarioModel

@{
    ViewBag.Title = "Recuperar acceso | LEN";
}

<section class="py-5">
    <div class="container-lg">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <div class="text-center pb-4">
                    <h1 class="display-6 fw-bold">Recuperar contraseña</h1>
                    <p class="text-muted m-0">
                        Ingrese el correo electrónico asociado a su cuenta.
                    </p>
                </div>

                <div class="border rounded p-4">
                    @using (Html.BeginForm("ForgotPassword", "Home", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        if (ViewData.ModelState[string.Empty] != null &&
                            ViewData.ModelState[string.Empty].Errors.Count > 0)
                        {
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        }

                        <div class="mb-4">
                            @Html.LabelFor(Modelo => Modelo.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(
                                Modelo => Modelo.Email,
                                new
                                {
                                    @class = "form-control",
                                    type = "email",
                                    autocomplete = "email",
                                    placeholder = "correo@ejemplo.com"
                                }
                            )
                            @Html.ValidationMessageFor(Modelo => Modelo.Email, "", new { @class = "text-danger small" })
                        </div>

                        <button class="btn btn-dark w-100" type="submit">
                            Enviar contraseña temporal
                        </button>
                    }

                    <p class="text-muted small mt-3 mb-0">
                        Revise la bandeja de entrada y la carpeta de correo no deseado.
                    </p>
                </div>

                <p class="text-center pt-3 m-0">
                    ¿Recordó su contraseña?
                    <a href="@Url.Action("Login", "Home")" class="fw-bold text-hover">Volver al inicio de sesión</a>
                </p>

            </div>
        </div>
    </div>
</section>
