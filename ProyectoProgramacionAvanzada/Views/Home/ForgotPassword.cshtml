
@{
    ViewBag.Title = "ForgotPassword";
}

<form class="card card-md" action="{{ page | relative }}/" method="get" autocomplete="off" novalidate>
    <div class="card-body">
        <h2 class="card-title text-center mb-4">Recuperar Acceso</h2>

        <p class="text-secondary mb-4">Agregue su correo eléctronico y una contraseña temporal será enviada.</p>

        <div class="mb-3">
            <label class="form-label">Correo eléctronico</label>
            <input type="email" class="form-control" placeholder="Agregue su correo eléctronico.">
        </div>
        <div class="form-footer">
            {% include "ui/button.html" text="Enviar contraseña temporal" block=true color="primary" icon="mail" %}
        </div>
    </div>
</form>
<div class="text-center text-secondary mt-3">
    Forget it, <a href="{{ page | relative }}/sign-in.html">send me back</a> to the sign in screen.
</div>
