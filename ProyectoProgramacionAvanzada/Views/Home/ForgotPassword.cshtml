@{
    ViewBag.Title = "Recuperar Acceso";
}

<section class="py-5">
    <div class="container-lg">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="card border-0 shadow-sm p-4">
                    <div class="card-body">
                        <h2 class="card-title text-center fs-3 fw-normal mb-4">Recuperar Acceso</h2>

                        @if (ViewBag.Confirmacion != null)
                        {
                            <div class="alert alert-success text-center" role="alert">
                                @ViewBag.Confirmacion
                            </div>
                        }

                        <p class="text-secondary text-center mb-4">
                            Agregue su correo electrónico y una contraseña temporal le será enviada.
                        </p>

                        @using (Html.BeginForm("ForgotPassword", "Home", FormMethod.Post, new { autocomplete = "off", id = "forgot-form" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label" for="email">Correo electrónico</label>
                                <input type="email"
                                       id="email"
                                       name="email"
                                       class="form-control"
                                       placeholder="ejemplo@correo.com"
                                       required>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-red hvr-sweep-to-right dark-sweep">
                                    Enviar contraseña temporal
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="text-center text-secondary mt-3">
                    ¿Ya lo recordaste?
                    <a href="@Url.Action("Index", "Home")">Volver al inicio de sesión</a>.
                </div>
            </div>
        </div>
    </div>
</section>
