@model ProyectoProgramacionAvanzada.Models.PagoViewModel

@using System
@using System.Globalization

@{
    ViewBag.Title = "Pagos";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";

    CultureInfo CulturaCostaRica =
        new CultureInfo("es-CR");
}

<div class="page-heading">

    <div class="page-heading-copy">

        <span class="page-icon">
            <i class="bi bi-credit-card"
               aria-hidden="true"></i>
        </span>

        <div>

            <p class="eyebrow mb-1">
                Administración
            </p>

            <h1 class="h3 mb-1">
                Pagos
            </h1>

            <p class="text-muted mb-0">
                Consulta los pagos registrados,
                montos, métodos y comprobantes.
            </p>

        </div>

    </div>

</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"
           aria-hidden="true"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-circle me-2"
           aria-hidden="true"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

<section class="row g-3 mt-1 mb-4"
         aria-label="Indicadores de pagos">

    <div class="col-12 col-sm-6 col-xl-3">

        <article class="metric-card metric-primary">

            <div class="metric-top">

                <span class="metric-label">
                    Total de pagos
                </span>

                <span class="metric-icon">
                    <i class="bi bi-credit-card"
                       aria-hidden="true"></i>
                </span>

            </div>

            <div class="metric-value">
                @Model.TotalPagos
            </div>

            <div class="metric-meta">
                <span>Pagos registrados</span>
            </div>

        </article>

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <article class="metric-card metric-success">

            <div class="metric-top">

                <span class="metric-label">
                    Total recaudado
                </span>

                <span class="metric-icon">
                    <i class="bi bi-cash-stack"
                       aria-hidden="true"></i>
                </span>

            </div>

            <div class="metric-value">

                @Model.TotalRecaudado.ToString(
                    "C0",
                    CulturaCostaRica
                )

            </div>

            <div class="metric-meta">
                <span>Monto acumulado</span>
            </div>

        </article>

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <article class="metric-card metric-warning">

            <div class="metric-top">

                <span class="metric-label">
                    Pagos de hoy
                </span>

                <span class="metric-icon">
                    <i class="bi bi-calendar-check"
                       aria-hidden="true"></i>
                </span>

            </div>

            <div class="metric-value">
                @Model.PagosHoy
            </div>

            <div class="metric-meta">
                <span>Transacciones del día</span>
            </div>

        </article>

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

        <article class="metric-card metric-primary">

            <div class="metric-top">

                <span class="metric-label">
                    Recaudado hoy
                </span>

                <span class="metric-icon">
                    <i class="bi bi-currency-dollar"
                       aria-hidden="true"></i>
                </span>

            </div>

            <div class="metric-value">

                @Model.RecaudadoHoy.ToString(
                    "C0",
                    CulturaCostaRica
                )

            </div>

            <div class="metric-meta">
                <span>Total recibido hoy</span>
            </div>

        </article>

    </div>

</section>

<section class="panel">

    <div class="panel-header d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center
                gap-3">

        <div>

            <h2 class="h5 mb-1 section-title">

                <i class="bi bi-receipt"
                   aria-hidden="true"></i>

                <span>
                    Historial de pagos
                </span>

            </h2>

            <p class="text-muted mb-0">
                Consulta los pagos registrados en el sistema.
            </p>

        </div>

        <div style="width: 100%; max-width: 340px;">

            <label class="visually-hidden"
                   for="BuscarPago">
                Buscar pago
            </label>

            <div class="input-group">

                <span class="input-group-text">

                    <i class="bi bi-search"
                       aria-hidden="true"></i>

                </span>

                <input type="search"
                       id="BuscarPago"
                       class="form-control"
                       placeholder="Buscar pago..."
                       autocomplete="off" />

            </div>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table align-middle mb-0"
               id="TablaPagos">

            <thead>

                <tr>
                    <th>Pago</th>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Método</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Comprobante</th>
                    <th>Estado</th>
                </tr>

            </thead>

            <tbody>

                @if (
                    Model.Pagos == null ||
                    Model.Pagos.Count == 0)
                {
                    <tr>

                        <td colspan="8"
                            class="text-center text-muted py-5">

                            <i class="bi bi-credit-card
                                      fs-3
                                      d-block
                                      mb-2"
                               aria-hidden="true"></i>

                            No hay pagos registrados.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var Pago in Model.Pagos)
                    {
                        bool EstaPagado =
                            string.Equals(
                                Pago.NombreEstado,
                                "Pagado",
                                StringComparison.OrdinalIgnoreCase
                            );

                        <tr class="FilaPago">

                            <td>

                                <span class="fw-semibold">
                                    #@Pago.IdPago
                                </span>

                            </td>

                            <td>

                                <a href="@Url.Action(
                                    "Detalle",
                                    "PedidoAdmin",
                                    new
                                    {
                                        IdPedido = Pago.IdPedido
                                    }
                                )"
                                   class="text-decoration-none">

                                    #@Pago.IdPedido

                                </a>

                            </td>

                            <td>

                                <strong class="d-block">
                                    @Pago.NombreCliente
                                </strong>

                                <small class="text-muted">
                                    @Pago.EmailCliente
                                </small>

                            </td>

                            <td>

                                <span class="badge bg-light text-dark">

                                    @Pago.NombreMetodoPago

                                </span>

                            </td>

                            <td>

                                <span class="fw-semibold">

                                    @Pago.Monto.ToString(
                                        "C0",
                                        CulturaCostaRica
                                    )

                                </span>

                            </td>

                            <td>

                                <span class="d-block">

                                    @Pago.FechaPago.ToString(
                                        "dd/MM/yyyy"
                                    )

                                </span>

                                <small class="text-muted">

                                    @Pago.FechaPago.ToString(
                                        "hh:mm tt"
                                    )

                                </small>

                            </td>

                            <td>

                                @if (string.IsNullOrWhiteSpace(
                                    Pago.Comprobante))
                                {
                                    <span class="text-muted">
                                        Sin comprobante
                                    </span>
                                }
                                else
                                {
                                    <span title="@Pago.Comprobante">

                                        @Pago.Comprobante

                                    </span>
                                }

                            </td>

                            <td>

                                @if (EstaPagado)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle me-1"
                                           aria-hidden="true"></i>

                                        Pagado

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        @Pago.NombreEstado

                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

    <div id="MensajeSinResultados"
         class="text-center text-muted py-5 d-none">

        <i class="bi bi-search
                  fs-3
                  d-block
                  mb-2"
           aria-hidden="true"></i>

        No se encontraron pagos.

    </div>

</section>

@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const Buscador =
                    document.getElementById(
                        "BuscarPago"
                    );

                const Filas =
                    document.querySelectorAll(
                        "#TablaPagos .FilaPago"
                    );

                const MensajeSinResultados =
                    document.getElementById(
                        "MensajeSinResultados"
                    );

                if (!Buscador) {
                    return;
                }

                Buscador.addEventListener(
                    "input",
                    function () {

                        const Texto =
                            this.value
                                .toLowerCase()
                                .trim();

                        let Coincidencias = 0;

                        Filas.forEach(
                            function (Fila) {

                                const Contenido =
                                    Fila.textContent
                                        .toLowerCase();

                                const Mostrar =
                                    Contenido.includes(
                                        Texto
                                    );

                                Fila.style.display =
                                    Mostrar
                                        ? ""
                                        : "none";

                                if (Mostrar) {
                                    Coincidencias++;
                                }
                            }
                        );

                        if (MensajeSinResultados) {

                            MensajeSinResultados
                                .classList
                                .toggle(
                                    "d-none",
                                    Coincidencias > 0
                                );
                        }
                    }
                );
            }
        );

    </script>
}