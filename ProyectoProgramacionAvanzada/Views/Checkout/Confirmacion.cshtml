@model ProyectoProgramacionAvanzada.Models.ConfirmacionViewModel

@{
    ViewBag.Title = "Compra confirmada | LEN";
}

<section class="py-5">
    <div class="container-lg">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="text-center pb-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white fw-bold mb-3"
                          style="width: 64px; height: 64px; font-size: 2rem;"
                          aria-hidden="true">✓</span>

                    <h1 class="display-6 fw-bold">¡Gracias por su compra!</h1>
                    <p class="text-muted">
                        Su pedido fue registrado y pagado correctamente.
                    </p>

                    <p class="fs-5 m-0">
                        Número de factura:
                        <span class="fw-bold">@Model.NumeroFactura</span>
                    </p>
                    <p class="text-muted">
                        @Model.FechaPedido.ToString("dd/MM/yyyy hh:mm tt")
                        · Estado:
                        <span class="badge bg-success">@Model.EstadoVisible</span>
                    </p>
                </div>

                <div class="border rounded p-4 mb-4">
                    <h2 class="h5 fw-bold pb-2">Productos</h2>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Producto</th>
                                    <th scope="col" class="text-center">Cantidad</th>
                                    <th scope="col" class="text-end">Precio</th>
                                    <th scope="col" class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var Linea in Model.Lineas)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Linea.RutaImagen) ? "Content/Images/logo.jpeg" : Linea.RutaImagen))"
                                                     alt="@Linea.NombreProducto"
                                                     class="rounded img-producto-mini">
                                                <span>@Linea.NombreProducto</span>
                                            </div>
                                        </td>
                                        <td class="text-center">@Linea.Cantidad</td>
                                        <td class="text-end">
                                            @string.Format("₡{0:N2}", Linea.PrecioUnitario)
                                        </td>
                                        <td class="text-end">
                                            @string.Format("₡{0:N2}", Linea.SubtotalLinea)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <hr>

                    <div class="row justify-content-end">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between">
                                <span>Subtotal</span>
                                <span>@string.Format("₡{0:N2}", Model.Subtotal)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Costo de envío</span>
                                <span>@string.Format("₡{0:N2}", Model.CostoEnvio)</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold fs-5">
                                <span>Total pagado</span>
                                <span>@string.Format("₡{0:N2}", Model.Total)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 pb-4">
                    <div class="col-md-6">
                        <div class="border rounded p-4 h-100">
                            <h2 class="h6 fw-bold pb-2">Dirección de envío</h2>
                            <p class="m-0">
                                <span class="fw-bold">@Model.NombreDestinatario</span><br>
                                @Model.DireccionExacta<br>
                                <span class="text-muted">
                                    @Model.NombreDistrito, @Model.NombreCanton, @Model.NombreProvincia
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-4 h-100">
                            <h2 class="h6 fw-bold pb-2">Pago</h2>
                            <p class="m-0">
                                Método: <span class="fw-bold">@Model.NombreMetodoPago</span><br>
                                <span class="text-muted">
                                    Pago simulado registrado correctamente.
                                </span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    <a href="@Url.Action("Historial", "Pedido")" class="btn btn-dark px-4">
                        Ver mis pedidos
                    </a>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark px-4">
                        Seguir comprando
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>
