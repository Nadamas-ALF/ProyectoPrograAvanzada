@model ProyectoProgramacionAvanzada.Models.ListadoFacturasViewModel

@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

@helper BadgeEstado(string NombreEstado)
{
    var Clase = "bg-light text-dark";

    switch (NombreEstado)
    {
        case "Pagado":
            Clase = "bg-success";
            break;
        case "Pendiente":
            Clase = "bg-warning text-dark";
            break;
        case "Cancelado":
            Clase = "bg-danger";
            break;
    }

    <span class="badge @Clase">@NombreEstado</span>
}

<div class="page-heading">

    <div class="page-heading-copy">

        <span class="page-icon">
            <i class="bi bi-receipt" aria-hidden="true"></i>
        </span>

        <div>
            <p class="eyebrow mb-1">
                Facturación
            </p>

            <h1 class="h3 mb-1">
                Facturas emitidas
            </h1>

            <p class="text-muted mb-0">
                Consulta las facturas generadas por las compras
                de la tienda.
            </p>
        </div>

    </div>

</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensajeExito"]
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-warning" role="alert">
        @TempData["MensajeError"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "Factura")" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label" for="busqueda">Buscar</label>
                <input type="text"
                       class="form-control"
                       id="busqueda"
                       name="busqueda"
                       value="@Model.Busqueda"
                       placeholder="Número de factura, cliente o correo" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label" for="fechaInicio">Desde</label>
                <input type="date"
                       class="form-control"
                       id="fechaInicio"
                       name="fechaInicio"
                       value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label" for="fechaFin">Hasta</label>
                <input type="date"
                       class="form-control"
                       id="fechaFin"
                       name="fechaFin"
                       value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-12 col-md-3 d-grid">
                <button type="submit" class="btn btn-outline-dark">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>
                    Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Facturas.Count == 0)
{
    <div class="text-center py-5 border rounded">
        <h2 class="h5 pb-2">No se encontraron facturas</h2>
        <p class="text-muted m-0">
            Ajuste los filtros de búsqueda.
        </p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Factura</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Método de pago</th>
                        <th scope="col" class="text-end">Total</th>
                        <th scope="col" class="text-center">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Factura in Model.Facturas)
                    {
                        <tr>
                            <td><strong>@Factura.NumeroFactura</strong></td>
                            <td>
                                @Factura.NombreCliente
                                <br />
                                <small class="text-muted">@Factura.EmailCliente</small>
                            </td>
                            <td>@Factura.FechaFactura.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td>
                                @(string.IsNullOrEmpty(Factura.MetodoPago)
                                    ? "—"
                                    : Factura.MetodoPago)
                                @if (!string.IsNullOrEmpty(Factura.Comprobante))
                                {
                                    <br />
                                    <small class="text-muted">@Factura.Comprobante</small>
                                }
                            </td>
                            <td class="text-end">₡@Factura.Total.ToString("N2")</td>
                            <td class="text-center">@BadgeEstado(Factura.NombreEstado)</td>
                            <td class="text-end">
                                <a href="@Url.Action("Detalle", "Factura", new { id = Factura.IdFactura })"
                                   class="btn btn-sm btn-outline-dark">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de facturas" class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int Pagina = 1; Pagina <= Model.TotalPaginas; Pagina++)
                {
                    <li class="page-item @(Pagina == Model.PaginaActual ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "Factura", new
                                 {
                                     busqueda = Model.Busqueda,
                                     fechaInicio = Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : null,
                                     fechaFin = Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : null,
                                     pagina = Pagina
                                 })">
                            @Pagina
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
